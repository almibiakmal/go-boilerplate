# Application
APP_NAME=maj-core-srvc
APP_ENV=development

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Auth & Security
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_ISSUER=maj-core-srvc
AUTH_INTERNAL_API_KEY=internal-dev-key

# Rate Limiter
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_EXPIRATION=1m

# Logger (level: debug, info, warn, error | format: json, text | file: opsional mis. logs/app.log)
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_FILE=

# Database (supported DB_DRIVER: postgres, mysql, sqlite)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=maj_core_db
DB_SSLMODE=disable
# Optional: override full connection URL (jika kosong, otomatis dirakit dari variabel DB_* di atas)
DB_URL=

# Database Connection Pool
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=50
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m

# Migrations
MIGRATIONS_PATH=file://migrations
